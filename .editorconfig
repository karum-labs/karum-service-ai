# EditorConfig — https://editorconfig.org
#
# Shared style for every Karum repo; keeps editors aligned with the CI
# linters (gofmt, ruff format, dart format). VS Code honours this file via
# the EditorConfig extension.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[*.py]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
