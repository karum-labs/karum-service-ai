# karum-service-ai environment variables.
#
# Every variable the AI service reads, with its default. All values have working
# defaults, so the service boots in fixture mode with no .env file.
#
# The authoritative cross-repo list lives in the infra repo; this file mirrors
# the variables that affect THIS process only.

# --- Service identity ------------------------------------------------------
# HTTP port the AI service listens on; /health is served here.
AI_PORT=8082
# Interface the HTTP server binds. Narrow it to 127.0.0.1 for a laptop run.
AI_HOST=0.0.0.0
# gRPC port the AI service listens on.
AI_GRPC_PORT=9092
# Operational mode: live, fixture, or degraded. Reported on /health. The
# service has no fixture replay, so a draft always calls the model.
AI_MODE=fixture
# Human-readable service name used in logs and health payloads.
AI_SERVICE_NAME=service-ai

# --- Provider selection ----------------------------------------------------
# LLM provider: gemini (default), openai, openai-responses, anthropic, or ollama.
# Switching providers is a one-env-var change; no code edit required.
# Use openai-responses for the direct OpenAI SDK (client.responses.create)
# against Groq, Nebius, or any OpenAI-compatible endpoint.
AI_PROVIDER=gemini
# Model id. Empty means "use the provider's default" (see the backend's
# provider defaults).
AI_MODEL=
# Comma-separated fallback providers tried in order when the primary fails
# (LangChain ``with_fallbacks``). Empty disables fallbacks.
AI_FALLBACK_PROVIDERS=
# Opt-in LangSmith tracing. Off by default so prompts never leave the box.
AI_LANGCHAIN_TRACING=false

# --- Provider credentials --------------------------------------------------
# OpenAI API key. Used when AI_PROVIDER=openai.
AI_OPENAI_API_KEY=
# Base URL for an OpenAI-compatible endpoint (e.g. Nebius). Used when AI_PROVIDER=openai.
AI_OPENAI_BASE_URL=
# Anthropic API key. Used when AI_PROVIDER=anthropic.
AI_ANTHROPIC_API_KEY=
# Base URL for an Ollama server. Used when AI_PROVIDER=ollama.
AI_OLLAMA_BASE_URL=

# --- Gemini ----------------------------------------------------------------
# API key from Google AI Studio. When set, model calls use this key and do
# not bill the Cloud project. NEVER committed. GEMINI_API_KEY is still
# accepted as the legacy spelling.
AI_GEMINI_API_KEY=
# GCP project id. Used only when AI_GEMINI_API_KEY is empty.
AI_GCP_PROJECT_ID=
# GCP region hosting the Vertex endpoint.
AI_GCP_LOCATION=us-central1
# Gemini model id used for grounded checks and drafting.
AI_GEMINI_MODEL=gemini-3.8-flash

# --- Grounding -------------------------------------------------------------
# Maximum number of shortlist brands to run search grounding against.
AI_GROUNDING_SHORTLIST_CAP=5
# Maximum bounded follow-up taste probes the agent may request per run.
AI_PROBE_BUDGET=3

# --- Fixtures --------------------------------------------------------------
# The recorded model pack, used in fixture mode. Relative paths resolve
# against this repository's root; the pack ships in karum-infra.
AI_FIXTURES_DIR=../karum-infra/fixtures/ai

# --- Tuning ----------------------------------------------------------------
# Per-request timeout for a single model call, in seconds.
AI_MODEL_TIMEOUT_SECONDS=30.0
# Maximum output tokens allowed for one draft.
AI_MAX_OUTPUT_TOKENS=2048
# Number of retries when a response fails schema validation.
AI_SCHEMA_RETRY_LIMIT=1

# --- Logging ---------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, or ERROR.
AI_LOG_LEVEL=INFO
